PORT=3000
# MongoDB connection string (local or MongoDB Atlas)
DATABASE_URL="mongodb://localhost:27017/sharjah_jobs"
# Or MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/sharjah_jobs?retryWrites=true&w=majority"

ADMIN_API_KEY=replace-with-a-long-random-secret

# Search results via SerpAPI (Google Jobs). Obtain a key from https://serpapi.com/
SERPAPI_KEY=

# Maximum number of new jobs to process per run (defaults to 1)
MAX_JOBS_PER_RUN=1

# OpenAI-compatible resume tailoring. If unset, the app uses conservative template-based text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deploy apps-script/Code.gs as a Web App, then paste its URL and same secret here.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=replace-with-another-long-random-secret

# Optional: set to true to avoid sending and only mark approved apps for manual follow-up.
DRY_RUN=true
