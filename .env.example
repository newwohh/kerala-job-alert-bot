BOT_TOKEN=replace-with-your-bot-token
CHANNEL_ID=@your_channel
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=job_alerts
CRON_SCHEDULE=*/1 * * * *
MAX_PAGES=3
REQUEST_TIMEOUT_MS=15000
# Startup behavior
# If true, runs scraping immediately on server start (default: false)
RUN_JOBS_ON_STARTUP=false

# If false, disables cron scheduling entirely (no automatic job posting)
CRON_ENABLED=true

# Optional: post an onboarding announcement message to this chat on startup.
# Use your GROUP chat id (e.g. -1001234567890) or a @username.
ONBOARDING_CHAT_ID=

# Optional: add group and promotions to job posts
GROUP_TITLE=Join our community
GROUP_URL=
PROMO_TEXT=
PROMO_URL=
PROMO_BUTTON_TEXT=Learn more

ANALYTICS_ENABLED=false
ANALYTICS_CHAT_ID=
ANALYTICS_CRON=0 9 * * *
ANALYTICS_WINDOW_HOURS=24
ANALYTICS_ADMIN_IDS=

# Optional: health-check HTTP server port. Set to a positive number to enable
# (responds 200 on / and /healthz). Default 0 = disabled.
PORT=0
